#include <windows.h>
1 RT_MANIFEST "@CMAKE_BINARY_DIR@/app.manifest"
// ID 1 of type RT_GROUP_ICON is what Window::open loads for the class icon.
1 ICON "@CONVERTII_ICON_RC@"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Convertii native media tools\0"
   VALUE "ProductName", "Convertii\0"
   VALUE "ProductVersion", "0.2.0\0"
  END
 END
END
